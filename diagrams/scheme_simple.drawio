<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net"><diagram id="simple" name="Схема системы"><mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="500"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="core" value="&lt;b&gt;Программа sitcenter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;C++17: проверка данных, правила A-1…A-5, инциденты, аудит&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d49a1f;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="570" y="90" width="200" height="120" as="geometry"/></mxCell><mxCell id="csv" value="&lt;b&gt;Файлы кейса (CSV)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;sites.csv — участки&lt;br&gt;indicators.csv — показания&lt;br&gt;incidents.csv — инциденты&lt;br&gt;employees.csv — сотрудники и зоны&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="340" height="120" as="geometry"/></mxCell><mxCell id="out" value="&lt;b&gt;Результат&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;alerts_out.csv&lt;br&gt;incidents_out.csv&lt;br&gt;audit_log.csv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="850" y="90" width="180" height="120" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Панель диспетчера&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;браузер,&lt;br&gt;обновление раз в 5 с&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f6ee;strokeColor=#2f9e6a;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1080" y="90" width="160" height="120" as="geometry"/></mxCell><mxCell id="e0" value="данные кейса" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555;fontSize=11;" edge="1