<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram id="flow" name="1. Потоки данных"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="flow-1" value="Ситуационный центр птицефабрики: потоки данных" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="flow-2" value="&lt;b&gt;Эмулятор датчиков&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;indicators.csv (тесты, демо)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;dashed=1;fillColor=#f5f5f5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="310" y="60" width="190" height="60" as="geometry"/></mxCell><mxCell id="flow-3" value="&lt;b&gt;Датчики&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;температура, влажность,&lt;br&gt;вентиляция (в кейсе — CSV)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-4" value="&lt;b&gt;ПЛК / шлюз&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;передаёт показания;&lt;br&gt;в прототипе — indicators.csv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-5" value="&lt;b&gt;Сервис приёма&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;валидация, проверка HMAC,&lt;br&gt;дедупликация, контроль STALE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="170" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-6" value="&lt;b&gt;Карантин&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;битые строки + причина&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;dashed=1;fillColor=#f5f5f5;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="660" y="60" width="150" height="60" as="geometry"/></mxCell><mxCell id="flow-7" value="&lt;b&gt;База данных&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;участки, датчики, измерения,&lt;br&gt;инциденты, история статусов,&lt;br&gt;оповещения, пользователи&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="200" height="220" as="geometry"/></mxCell><mxCell id="flow-8" value="&lt;b&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;реестр инцидентов,&lt;br&gt;исполнитель на участке&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="310" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-9" value="&lt;b&gt;API инцидентов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RBAC, проверка&lt;br&gt;перехода статуса&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="310" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-10" value="&lt;b&gt;Администратор&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;нормы, справочники,&lt;br&gt;пользователи&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="880" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="flow-11" value="&lt;b&gt;Движок правил&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;пороги, уровни,&lt;br&gt;подтверждение 2 каналами,&lt;br&gt;гистерезис&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="880" y="470" width="200" height="80" as="geometry"/></mxCell><mxCell id="flow-12" value="&lt;b&gt;Сервис оповещений&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;INFO / WARNING / CRITICAL / STALE&lt;br&gt;АРМ, SMS / мессенджер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="580" y="470" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-13" value="&lt;b&gt;АРМ диспетчера&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;подтверждает оповещения,&lt;br&gt;назначает исполнителя&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="310" y="470" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-14" value="&lt;b&gt;Руководитель&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;эскалации при просрочке,&lt;br&gt;отчёты, закрытие критичных&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="190" height="80" as="geometry"/></mxCell><mxCell id="flow-15" value="&lt;b&gt;Журнал аудита&lt;/b&gt;: каждый приём данных, оповещение, смена статуса и вход пользователя (ФИО маскируется)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#f5f5f5;" vertex="1" parent="1"><mxGeometry x="40" y="600" width="1040" height="40" as="geometry"/></mxCell><mxCell id="flow-16" value="4–20 мА /&lt;br&gt;дискрет" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-3" target="flow-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-17" value="JSON + HMAC&lt;br&gt;MQTT / HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-4" target="flow-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-18" value="CSV" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;entryX=0.158;entryY=0;" edge="1" parent="1" source="flow-2" target="flow-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="90"/></Array></mxGeometry></mxCell><mxCell id="flow-19" value="неверные&lt;br&gt;данные" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.4167;entryY=1;dashed=1;" edge="1" parent="1" source="flow-5" target="flow-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-20" value="валидные&lt;br&gt;измерения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.2;" edge="1" parent="1" source="flow-5" target="flow-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-21" value="инцидент, фото, статусы ⇄ задания исполнителю" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;startArrow=block;startFill=1;exitX=1;exitY=0.3;entryX=0;entryY=0.3;" edge="1" parent="1" source="flow-8" target="flow-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-22" value="инциденты,&lt;br&gt;статусы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;entryX=0;entryY=0.727;" edge="1" parent="1" source="flow-9" target="flow-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-23" value="нормы, роли" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-10" target="flow-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-24" value="новые измерения" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-7" target="flow-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-25" value="оповещение" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-11" target="flow-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-26" value="автосоздание инцидента (CRITICAL)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.15;exitY=0;entryX=1;entryY=0.8;" edge="1" parent="1" source="flow-11" target="flow-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="910" y="430"/><mxPoint x="820" y="430"/><mxPoint x="820" y="374"/></Array></mxGeometry></mxCell><mxCell id="flow-27" value="тревоги" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-12" target="flow-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-28" value="эскалация" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="flow-13" target="flow-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="flow-29" value="назначение, статусы" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0;entryY=0.8;" edge="1" parent="1" source="flow-13" target="flow-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452.5" y="374"/></Array></mxGeometry></mxCell><mxCell id="flow-30" value="Безопасность: пакеты от шлюза подписаны HMAC; доступ к API по ролям (RBAC); в логах и оповещениях ФИО и телефоны маскируются." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="650" width="1040" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="er" name="2. Модель данных"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="er-1" value="Модель данных (ER)" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="er-2" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Участок (site)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;site_id&lt;/u&gt; PK&lt;br&gt;name&lt;br&gt;type (птичник, инкубаторий…)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="210" height="79" as="geometry"/></mxCell><mxCell id="er-3" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Тип показателя (indicator_type)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;indicator_code&lt;/u&gt; PK&lt;br&gt;name, unit&lt;br&gt;norm_min, norm_max&lt;br&gt;warn_pct (зона WARNING)&lt;br&gt;poll_interval_sec" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="230" width="230" height="109" as="geometry"/></mxCell><mxCell id="er-4" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Датчик (sensor)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;sensor_id&lt;/u&gt; PK&lt;br&gt;site_id FK&lt;br&gt;indicator_code FK&lt;br&gt;address (тег ПЛК)&lt;br&gt;last_seen_at&lt;br&gt;state: OK / FAULT / STALE" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="210" height="124" as="geometry"/></mxCell><mxCell id="er-5" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Измерение (measurement)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;measure_id&lt;/u&gt; PK&lt;br&gt;sensor_id FK&lt;br&gt;time&lt;br&gt;value&lt;br&gt;quality: OK / BAD&lt;br&gt;status: NORM / WARN / CRIT&lt;br&gt;dedup_key (уникальный)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="250" width="210" height="139" as="geometry"/></mxCell><mxCell id="er-6" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Правило (alert_rule)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;rule_id&lt;/u&gt; PK&lt;br&gt;indicator_code FK&lt;br&gt;condition&lt;br&gt;level&lt;br&gt;delay_sec (антидребезг)&lt;br&gt;confirm_with (2-й канал)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="230" height="124" as="geometry"/></mxCell><mxCell id="er-7" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Оповещение (alert)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;alert_id&lt;/u&gt; PK&lt;br&gt;measure_id FK&lt;br&gt;rule_id FK&lt;br&gt;level: INFO / WARNING / CRITICAL / STALE&lt;br&gt;created_at&lt;br&gt;ack_by FK user, ack_at&lt;br&gt;incident_id FK (nullable)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="470" width="250" height="139" as="geometry"/></mxCell><mxCell id="er-8" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Инцидент (incident)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;incident_id&lt;/u&gt; PK&lt;br&gt;type&lt;br&gt;site_id FK (location)&lt;br&gt;time&lt;br&gt;responsible FK user&lt;br&gt;status_code FK&lt;br&gt;deadline&lt;br&gt;source: APP / SENSOR&lt;br&gt;priority" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="220" height="169" as="geometry"/></mxCell><mxCell id="er-9" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;История статусов (status_history)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;id&lt;/u&gt; PK&lt;br&gt;incident_id FK&lt;br&gt;from_status, to_status&lt;br&gt;user_id FK&lt;br&gt;changed_at&lt;br&gt;comment" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="220" height="124" as="geometry"/></mxCell><mxCell id="er-10" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Статус (status)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;status_code&lt;/u&gt; PK&lt;br&gt;NEW / ASSIGNED /&lt;br&gt;IN_PROGRESS / CLOSED&lt;br&gt;name, order" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="920" y="60" width="230" height="94" as="geometry"/></mxCell><mxCell id="er-11" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Пользователь (user)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;user_id&lt;/u&gt; PK&lt;br&gt;fio (маскируется в логах)&lt;br&gt;phone&lt;br&gt;role_code FK&lt;br&gt;site_ids (зона ответственности)&lt;br&gt;active" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeColor=#555555;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="920" y="220" width="230" height="124" as="geometry"/></mxCell><mxCell id="er-12" value="&lt;div style=&quot;text-align:center;font-size:12px&quot;&gt;&lt;b&gt;Роль (role)&lt;/b&gt;&lt;/div&gt;&lt;hr&gt;&lt;u&gt;role_code&lt;/u&gt; PK&lt;br&gt;DISPATCHER / MANAGER /&lt;br&gt;ADMIN / EXECUTOR" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;strokeCol