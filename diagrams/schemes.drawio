;startArrow=ERmandOne;endFill=0;startFill=0;exitX=0;exitY=0.95;entryX=1;entryY=0.5;" edge="1" parent="1" source="er-11" target="er-13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="344"/><mxPoint x="895" y="554"/></Array></mxGeometry></mxCell><mxCell id="er-28" value="Колонки incidents.csv и indicators.csv из задания ложатся на Инцидент и Измерение; norm_min / norm_max берутся из Типа показателя." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1100" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="life" name="3. Жизненный цикл инцидента"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="life-1" value="Жизненный цикл инцидента" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="600" height="30" as="geometry"/></mxCell><mxCell id="life-2" value="&lt;b&gt;Датчик&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;2 CRITICAL за 15 мин&lt;br&gt;(правило A-3)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="170" height="60" as="geometry"/></mxCell><mxCell id="life-3" value="&lt;b&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;сотрудник на участке&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="170" height="60" as="geometry"/></mxCell><mxCell id="life-4" value="Новый&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;NEW&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=13;fontStyle=1;strokeColor=#555555;fillColor=#ffffff;fillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="280" y="140" width="120" height="60" as="geometry"/></mxCell><mxCell id="life-5" value="Назначен&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;ASSIGNED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=13;fontStyle=1;strokeColor=#555555;fillColor=#ffffff;fillColor=#fff2cc;" vertex="1" parent="1"><mxGeometry x="520" y="140" width="120" height="60" as="geometry"/></mxCell><mxCell id="life-6" value="В работе&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;IN_PROGRESS&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=13;fontStyle=1;strokeColor=#555555;fillColor=#ffffff;fillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="760" y="140" width="120" height="60" as="geometry"/></mxCell><mxCell id="life-7" value="Закрыт&lt;br&gt;&lt;font style=&quot;font-size:11px;font-weight:normal&quot;&gt;CLOSED&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fontSize=13;fontStyle=1;strokeColor=#555555;fillColor=#ffffff;fillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="1000" y="140" width="120" height="60" as="geometry"/></mxCell><mxCell id="life-8" value="&lt;b&gt;Эскалация&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;deadline прошёл, а инцидент не закрыт →&lt;br&gt;оповещение руководителю (статус не меняется)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;strokeColor=#555555;fillColor=#ffffff;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="330" width="400" height="60" as="geometry"/></mxCell><mxCell id="life-9" value="авто" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="life-2" target="life-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="life-10" value="создаёт" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="life-3" target="life-4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="life-11" value="Диспетчер:&lt;br&gt;назначить" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="life-4" target="life-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="life-12" value="Исполнитель:&lt;br&gt;в работу" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="life-5" target="life-6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="life-13" value="Исполнитель:&lt;br&gt;закрыть&lt;br&gt;+ комментарий" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="life-6" target="life-7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="life-14" value="переназначить&lt;br&gt;(Диспетчер)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="life-6" target="life-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="100"/><mxPoint x="580" y="100"/></Array></mxGeometry></mxCell><mxCell id="life-15" value="переоткрыть&lt;br&gt;(Руководитель)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;" edge="1" parent="1" source="life-7" target="life-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="250"/><mxPoint x="820" y="250"/></Array></mxGeometry></mxCell><mxCell id="life-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="life-5" target="life-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="life-17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;exitX=0.25;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="life-6" target="life-8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="life-18" value="&lt;b&gt;Кто переводит:&lt;/b&gt; Новый → Назначен — Диспетчер; Назначен → В работе и В работе → Закрыт — Исполнитель (или Диспетчер); переоткрыть — Руководитель.&lt;br&gt;&lt;b&gt;Запрещено:&lt;/b&gt; Новый → Закрыт без назначения; Закрыт без комментария; любой переход от Администратора (он настраивает систему, но не ведёт инциденты). Каждый переход пишется в Историю статусов и в Аудит. Повторная отправка того же перехода (тот же incident_id и to_status) не создаёт дубль." style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1080" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>