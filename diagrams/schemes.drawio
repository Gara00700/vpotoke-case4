<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net"><diagram id="flow" name="1. Потоки данных"><mxGraphModel dx="1440" dy="600" grid="1" gridSize="10" page="1" pageWidth="1440" pageHeight="600"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Потоки данных: программа sitcenter (C++17)" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="sites" value="&lt;b&gt;sites.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;участки и зоны&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="ind" value="&lt;b&gt;indicators.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;показания датчиков&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="170" width="220" height="60" as="geometry"/></mxCell><mxCell id="inc" value="&lt;b&gt;incidents.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;инциденты из приложения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="250" width="220" height="60" as="geometry"/></mxCell><mxCell id="emp" value="&lt;b&gt;employees.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;сотрудники, роли, участки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="220" height="60" as="geometry"/></mxCell><mxCell id="tr" value="&lt;b&gt;transitions.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;смены статусов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="30" y="480" width="220" height="60" as="geometry"/></mxCell><mxCell id="chk" value="&lt;b&gt;1. Проверка данных&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;участок есть в sites.csv,&lt;br&gt;число и норма корректны&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d49a1f;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="230" height="100" as="geometry"/></mxCell><mxCell id="rej" value="&lt;b&gt;Отклонено&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;422 + код ошибки&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbebeb;strokeColor=#c0504d;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="330" y="290" width="230" height="70" as="geometry"/></mxCell><mxCell id="dup" value="&lt;b&gt;2. Отсев повторов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;тот же датчик за 5 мин&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d49a1f;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="40" width="250" height="80" as="geometry"/></mxCell><mxCell id="sev" value="&lt;b&gt;3. Уровень опасности&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;NORMAL / WARNING /&lt;br&gt;CRITICAL / STALE&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d49a1f;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="160" width="250" height="80" as="geometry"/></mxCell><mxCell id="auto" value="&lt;b&gt;4. Инциденты&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;проверенные из файла +&lt;br&gt;автоинцидент: 2 CRITICAL за 15 мин&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d49a1f;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="250" height="80" as="geometry"/></mxCell><mxCell id="rbac" value="&lt;b&gt;5. Переходы статусов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;проверка роли и участка&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4dc;strokeColor=#d49a1f;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="640" y="450" width="250" height="80" as="geometry"/></mxCell><mxCell id="aout" value="&lt;b&gt;alerts_out.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;оповещения&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f6ee;strokeColor=#2f9e6a;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="970" y="160" width="200" height="80" as="geometry"/></mxCell><mxCell id="iout" value="&lt;b&gt;incidents_out.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;инциденты и статусы&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f6ee;strokeColor=#2f9e6a;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="970" y="300" width="200" height="80" as="geometry"/></mxCell><mxCell id="log" value="&lt;b&gt;audit_log.csv&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;кто, что, когда&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f6ee;strokeColor=#2f9e6a;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="970" y="450" width="200" height="80" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Панель диспетчера&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;браузер, 5 вкладок,&lt;br&gt;обновление раз в 5 с&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f1fb;strokeColor=#3a78b5;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="280" width="170" height="120" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sites" target="chk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ind" target="chk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inc" target="chk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="ошибка" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="chk" target="rej"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="верно" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="chk" target="dup"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="новое" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="dup" target="sev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="не NORMAL" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sev" target="aout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="CRITICAL" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sev" target="auto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="auto" target="iout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="инциденты" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="chk" target="auto"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="emp" target="rbac"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="tr" target="rbac"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="новый статус" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rbac" target="iout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="+ отказы" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rbac" target="log"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="aout" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="iout" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="log" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="Вся логика — в одной программе. Панель только показывает выходные файлы. Реальные датчики не подключаются: показания берутся из CSV кейса." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="564" width="1380" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="er" name="2. Модель данных (ER)"><mxGraphModel dx="1460" dy="640" grid="1" gridSize="10" page="1" pageWidth="1460" pageHeight="640"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Модель данных: 6 сущностей" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="site" value="&lt;div style=&quot;background:#eef2f5;padding:4px 8px;font-weight:bold;border-bottom:2px solid #7a8a99&quot;&gt;Site — участок&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;text-align:left&quot;&gt;&lt;b&gt;PK site_id&lt;/b&gt;&lt;br&gt;name&lt;br&gt;zone&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8a99;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="300" height="100" as="geometry"/></mxCell><mxCell id="sensor" value="&lt;div style=&quot;background:#eef2f5;padding:4px 8px;font-weight:bold;border-bottom:2px solid #7a8a99&quot;&gt;Sensor — датчик&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;text-align:left&quot;&gt;&lt;b&gt;PK sensor_id&lt;/b&gt;&lt;br&gt;FK site_id → Site&lt;br&gt;indicator&lt;br&gt;status: ACTIVE / OFFLINE&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8a99;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="300" height="122" as="geometry"/></mxCell><mxCell id="meas" value="&lt;div style=&quot;background:#eef2f5;padding:4px 8px;font-weight:bold;border-bottom:2px solid #7a8a99&quot;&gt;Measurement — показание&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;text-align:left&quot;&gt;&lt;b&gt;PK measurement_id&lt;/b&gt;&lt;br&gt;FK sensor_id → Sensor&lt;br&gt;time&lt;br&gt;value (пусто = STALE)&lt;br&gt;norm_min, norm_max&lt;br&gt;status&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8a99;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="760" y="70" width="300" height="166" as="geometry"/></mxCell><mxCell id="alert" value="&lt;div style=&quot;background:#eef2f5;padding:4px 8px;font-weight:bold;border-bottom:2px solid #7a8a99&quot;&gt;Alert — оповещение&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;text-align:left&quot;&gt;&lt;b&gt;PK alert_id&lt;/b&gt;&lt;br&gt;FK measurement_id → Measurement&lt;br&gt;severity&lt;br&gt;action&lt;br&gt;at&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8a99;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="1120" y="70" width="300" height="144" as="geometry"/></mxCell><mxCell id="inc" value="&lt;div style=&quot;background:#eef2f5;padding:4px 8px;font-weight:bold;border-bottom:2px solid #7a8a99&quot;&gt;Incident — инцидент&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;text-align:left&quot;&gt;&lt;b&gt;PK incident_id&lt;/b&gt;&lt;br&gt;FK location → Site&lt;br&gt;type, time&lt;br&gt;responsible (employee_id)&lt;br&gt;status&lt;br&gt;deadline&lt;br&gt;source: mobile / sensor / auto&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8a99;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="40" y="380" width="300" height="188" as="geometry"/></mxCell><mxCell id="audit" value="&lt;div style=&quot;background:#eef2f5;padding:4px 8px;font-weight:bold;border-bottom:2px solid #7a8a99&quot;&gt;AuditEvent — журнал&lt;/div&gt;&lt;div style=&quot;padding:6px 8px;text-align:left&quot;&gt;&lt;b&gt;PK event_id&lt;/b&gt;&lt;br&gt;entity_type: incident / alert&lt;br&gt;FK entity_id → Incident / Alert&lt;br&gt;action&lt;br&gt;actor&lt;br&gt;at&lt;/div&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7a8a99;strokeWidth=2;fontSize=13;align=left;verticalAlign=top;spacing=0;overflow=fill;" vertex="1" parent="1"><mxGeometry x="760" y="380" width="300" height="166" as="geometry"/></mxCell><mxCell id="e0" value="1 : N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="site" target="sensor"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="1 : N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="sensor" target="meas"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="1 : N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="meas" target="alert"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1 : N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="site" target="inc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="1 : N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="inc" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="1 : N" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="alert" target="audit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note" value="В CSV кейса датчик задаётся парой location + indicator: она же ключ отсева повторов. Сотрудники (employees.csv) — справочник прав, в модель из 6 сущностей не входят." style="text;html=1;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="604" width="1400" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="life" name="3. Жизненный цикл инцидента"><mxGraphModel dx="1500" dy="570" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="570"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Жизненный цикл инцидента" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="8" width="900" height="30" as="geometry"/></mxCell><mxCell id="mob" value="&lt;b&gt;Мобильное приложение&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;инцидент из incidents.csv&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="au" value="&lt;b&gt;Автоинцидент&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;2 CRITICAL за 15 мин&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef2f5;strokeColor=#7a8a99;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="240" y="60" width="200" height="60" as="geometry"/></mxCell><mxCell id="new" value="&lt;b&gt;NEW&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;создан&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f1fb;strokeColor=#3a78b5;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="220" height="80" as="geometry"/></mxCell><mxCell id="as" value="&lt;b&gt;ASSIGNED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;назначен инженер&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f1fb;strokeColor=#3a78b5;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="220" height="80" as="geometry"/></mxCell><mxCell id="ip" value="&lt;b&gt;IN_PROGRESS&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;в работе&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f1fb;strokeColor=#3a78b5;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="860" y="200" width="220" height="80" as="geometry"/></mxCell><mxCell id="cl" value="&lt;b&gt;CLOSED&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;закрыт навсегда&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f6ee;strokeColor=#2f9e6a;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="200" width="220" height="80" as="geometry"/></mxCell><mxCell id="no" value="&lt;b&gt;Запрещено → отказ с кодом и запись в журнал&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;NEW → CLOSED и любой пропуск шага: INVALID_TRANSITION   ·   CLOSED → любой: повтор проблемы — новый инцидент&lt;br&gt;чужая роль: FORBIDDEN   ·   инженер не своего участка: OUT_OF_ZONE   ·   IN_PROGRESS назад нельзя: скрывает просрочку&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fbebeb;strokeColor=#c0504d;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="1400" height="110" as="geometry"/></mxCell><mxCell id="e0" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mob" target="new"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="au" target="new"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="диспетчер / руководитель" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="new" target="as"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="инженер своего участка" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="as" target="ip"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="только руководитель" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ip" target="cl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="руководитель, причина NO_ACTION (ложный вызов)" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#555555;fontSize=12;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;" edge="1" parent="1" source="as" target="cl"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="570" y="350"/><mxPoint x="1350" y="350"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
